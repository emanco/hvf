# HVF Auto-Trader environment variables.
# Copy to .env and fill in real values. .env is gitignored.

# ─── MetaTrader 5 ──────────────────────────────────────────────────────────
# Demo or live broker credentials. The bot uses one MT5 account at a time.
MT5_LOGIN=12345678
MT5_PASSWORD=your-mt5-password
MT5_SERVER=ICMarketsSC-Demo
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# ─── Telegram ──────────────────────────────────────────────────────────────
# Create a bot via @BotFather → token. Get your chat_id by messaging the bot
# then visiting https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=123456789

# ─── Optional ──────────────────────────────────────────────────────────────
# Defaults to sqlite:///hvf_trader.db (relative to working dir)
# DATABASE_URL=sqlite:///C:/hvf_trader/hvf_trader.db

# Defaults to "demo". Set to "live" only when ready for real money.
ENVIRONMENT=demo
